# ============================================================
# Flight Ticket Management System
# Global .gitignore
# ============================================================


# ============================================================
# ENVIRONMENT VARIABLES & SECRETS
# ============================================================

.env
.env.*
!.env.example
!.env.sample

# Local environment files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Secret / credential files
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore

# API / cloud credentials
credentials.json
service-account.json
serviceAccount.json
google-credentials.json
firebase-adminsdk-*.json

# Generic secret/config files
secrets.json
secret.json
secrets/
.secret/
.private/
.private/


# ============================================================
# NODE.JS / NPM
# ============================================================

node_modules/
.npm/
.npmrc

# NPM debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Package manager caches
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.yarn/build-state.yml
.yarn/install-state/


# ============================================================
# LOGS
# ============================================================

logs/
*.log
*.log.*
debug.log
error.log
combined.log
access.log


# ============================================================
