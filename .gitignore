# ============================================================
# DATABASE / LOCAL DATABASE FILES
# ============================================================

# Local database files
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# MySQL dumps / backups generated locally
*.dump
*.bak
*.backup

# Ignore arbitrary SQL dumps/backups
*.sql.bak
*.sql.backup
*.sql.dump

# IMPORTANT:
# Your actual project database schema is intentionally tracked:
# database/database.sql
#
# Do NOT add *.sql here because that would ignore your main
# database/database.sql file.


