<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/admin-sidebar', { active: 'dashboard' }) %>

<div class="main-content">
  <h3 class="mb-4">Dashboard Overview</h3>
  <div class="row g-3 mb-4">
    <div class="col-md-3"><div class="stat-card">
      <div class="stat-icon" style="background:rgba(223,33,137,0.1);color:var(--primary)"><i class="bi bi-people"></i></div>
      <div class="stat-value"><%= stats.usersCount %></div>
      <div class="stat-label">Total Users</div>
    </div></div>
    <div class="col-md-3"><div class="stat-card">
      <div class="stat-icon" style="background:rgba(16,185,129,0.1);color:#10b981"><i class="bi bi-airplane"></i></div>
      <div class="stat-value"><%= stats.flightsCount %></div>
      <div class="stat-label">Active Flights</div>
    </div></div>
    <div class="col-md-3"><div class="stat-card">
      <div class="stat-icon" style="background:rgba(59,130,246,0.1);color:#3b82f6"><i class="bi bi-receipt"></i></div>
      <div class="stat-value"><%= stats.bookingsCount %></div>
      <div class="stat-label">Total Bookings</div>
    </div></div>
    <div class="col-md-3"><div class="stat-card">
      <div class="stat-icon" style="background:rgba(245,158,11,0.1);color:#f59e0b"><i class="bi bi-currency-rupee"></i></div>
      <div class="stat-value">₹<%= stats.revenue %></div>
      <div class="stat-label">Total Revenue</div>
    </div></div>
  </div>
  <div class="row">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header"><h5 class="mb-0">Quick Actions</h5></div>
        <div class="card-body"><div class="d-grid gap-2">
          <a href="/admin/flights/add" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add New Flight</a>
          <a href="/admin/airports/add" class="btn btn-success"><i class="bi bi-plus-circle"></i> Add Airport</a>
          <a href="/admin/bookings" class="btn btn-info text-white"><i class="bi bi-receipt"></i> View All Bookings</a>
          <a href="/admin/reports" class="btn btn-warning"><i class="bi bi-graph-up"></i> View Reports</a>
        </div></div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card">
        <div class="card-header"><h5 class="mb-0">Recent Bookings</h5></div>
        <div class="card-body p-0">
          <% if (recentBookings.length === 0) { %>
            <div class="text-center text-muted py-4">No bookings yet</div>
          <% } else { %>
            <ul class="list-group list-group-flush">
              <% recentBookings.forEach(b => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                  <div><strong><%= b.pnr %></strong><br><small class="text-muted"><%= b.user_name %> · <%= b.flight_number %></small></div>
                  <span class="badge bg-primary">₹<%= b.total_amount %></span>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
