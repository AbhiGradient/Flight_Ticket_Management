<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/admin-sidebar', { active: 'airports' }) %>

<div class="main-content">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Manage Airports</h3>
    <a href="/admin/airports/add" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add Airport</a>
  </div>
  <div class="card">
    <div class="card-body p-0">
      <% if (airports.length === 0) { %>
        <div class="text-center text-muted py-5"><i class="bi bi-building display-1"></i><h5 class="mt-3">No airports</h5></div>
      <% } else { %>
        <table class="table">
          <thead><tr><th>Code</th><th>Name</th><th>City</th><th>Country</th><th>Actions</th></tr></thead>
          <tbody>
            <% airports.forEach(a => { %>
              <tr>
                <td><span class="badge bg-primary"><%= a.code %></span></td>
                <td><%= a.name %></td>
                <td><%= a.city %></td>
                <td><%= a.country %></td>
                <td>
                  <a href="/admin/airports/edit/<%= a.id %>" class="btn btn-sm btn-outline-warning">Edit</a>
                  <a href="/admin/airports/delete/<%= a.id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete?')">Delete</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
