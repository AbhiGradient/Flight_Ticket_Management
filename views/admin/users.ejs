<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/admin-sidebar', { active: 'users' }) %>

<div class="main-content">
  <h3 class="mb-3">All Users</h3>
  <div class="card">
    <div class="card-body p-0">
      <% if (users.length === 0) { %>
        <div class="text-center text-muted py-5"><i class="bi bi-people display-1"></i><h5 class="mt-3">No users</h5></div>
      <% } else { %>
        <div class="table-responsive"><table class="table">
          <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Joined</th></tr></thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr>
                <td>#<%= u.id %></td>
                <td><strong><%= u.name %></strong></td>
                <td><%= u.email %></td>
                <td><%= u.phone || '-' %></td>
                <td><span class="badge bg-<%= u.role==='admin'?'danger':'primary' %>"><%= u.role %></span></td>
                <td><%= new Date(u.created_at).toLocaleDateString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table></div>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
