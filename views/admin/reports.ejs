<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/admin-sidebar', { active: 'reports' }) %>

<div class="main-content">
  <h3 class="mb-3">Reports & Analytics</h3>
  <div class="row g-3 mb-4">
    <div class="col-md-6"><div class="stat-card">
      <div class="stat-icon" style="background:rgba(16,185,129,0.1);color:#10b981"><i class="bi bi-currency-rupee"></i></div>
      <div class="stat-value">₹<%= stats.totalRevenue %></div>
      <div class="stat-label">Total Confirmed Revenue</div>
    </div></div>
    <div class="col-md-6"><div class="stat-card">
      <div class="stat-icon" style="background:rgba(223,33,137,0.1);color:var(--primary)"><i class="bi bi-receipt"></i></div>
      <div class="stat-value"><%= stats.totalBookings %></div>
      <div class="stat-label">Total Bookings</div>
    </div></div>
  </div>
  <div class="card">
    <div class="card-header"><h5 class="mb-0">Revenue by Route</h5></div>
    <div class="card-body p-0">
      <% if (routeStats.length === 0) { %>
        <div class="text-center text-muted py-5">No confirmed bookings yet</div>
      <% } else { %>
        <table class="table">
          <thead><tr><th>Route</th><th>Bookings</th><th>Revenue</th><th>Avg per Booking</th></tr></thead>
          <tbody>
            <% routeStats.forEach(([route, data]) => { %>
              <tr>
                <td><strong><%= route %></strong></td>
                <td><span class="badge bg-primary"><%= data.count %></span></td>
                <td>₹<%= data.revenue %></td>
                <td>₹<%= Math.round(data.revenue / data.count) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
