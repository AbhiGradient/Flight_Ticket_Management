<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<div class="container my-5"><div class="row justify-content-center"><div class="col-md-5">
  <div class="card shadow border-dark"><div class="card-body p-4">
    <h3 class="text-center mb-4"><i class="bi bi-shield-lock"></i> Admin Login</h3>
    <form action="/admin/login" method="POST">
      <div class="mb-3"><label class="form-label">Admin Email</label><input type="email" name="email" class="form-control" required></div>
      <div class="mb-3"><label class="form-label">Password</label><input type="password" name="password" class="form-control" required></div>
      <button type="submit" class="btn btn-dark w-100">Admin Login</button>
    </form>
    <p class="text-center mt-3 mb-0"><a href="/login">Passenger Login</a></p>
  </div></div>
</div></div></div>
