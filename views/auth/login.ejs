<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<% if (success) { %>
  <div class="container mt-4"><div class="alert alert-success"><%= success %></div></div>
<% } %>
<% if (error) { %>
  <div class="container mt-4"><div class="alert alert-danger"><%= error %></div></div>
<% } %>

<div class="hero-banner">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-6 text-white">
        <h1>Sign in to FlightTicket</h1>
        <p class="lead mt-3">Book domestic & international flights at the best prices.</p>
        <ul class="list-unstyled mt-4">
          <li class="mb-2"><i class="bi bi-check-circle-fill"></i> Free cancellation within 24 hours</li>
          <li class="mb-2"><i class="bi bi-check-circle-fill"></i> Instant e-ticket delivery</li>
          <li class="mb-2"><i class="bi bi-check-circle-fill"></i> Secure payments</li>
        </ul>
      </div>
      <div class="col-md-5 offset-md-1">
        <div class="card shadow-lg">
          <div class="card-body p-4">
            <div class="login-toggle-wrapper">
              <button type="button" id="passengerBtn" class="active" onclick="switchLogin('passenger')">
                <i class="bi bi-person"></i> Passenger
              </button>
              <button type="button" id="adminBtn" onclick="switchLogin('admin')">
                <i class="bi bi-shield-lock"></i> Admin
              </button>
            </div>

            <form id="passengerForm" action="/login" method="POST">
              <h4 class="mb-3">Passenger Login</h4>
              <div class="mb-3">
                <label class="form-label">Email Address</label>
                <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" placeholder="Enter your password" required>
              </div>
              <button type="submit" class="btn btn-primary w-100">Sign In</button>
              <p class="text-center mt-3 mb-0 small text-muted">
                Don't have an account? <a href="/register" class="text-decoration-none fw-bold" style="color:var(--primary)">Register here</a>
              </p>
            </form>

            <form id="adminForm" action="/admin/login" method="POST" style="display:none">
              <h4 class="mb-3">Admin Login</h4>
              <div class="mb-3">
                <label class="form-label">Admin Email</label>
                <input type="email" name="email" class="form-control" placeholder="admin@flight.com" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" placeholder="Enter admin password" required>
              </div>
              <button type="submit" class="btn btn-dark w-100">
                <i class="bi bi-shield-check"></i> Admin Sign In
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container my-5">
  <div class="row g-4">
    <div class="col-md-3 text-center"><i class="bi bi-airplane-fill display-4" style="color:var(--primary)"></i><h6 class="mt-2 fw-bold">200+ Airlines</h6><small class="text-muted">Worldwide coverage</small></div>
    <div class="col-md-3 text-center"><i class="bi bi-tag-fill display-4" style="color:var(--primary)"></i><h6 class="mt-2 fw-bold">Best Prices</h6><small class="text-muted">Guaranteed low fares</small></div>
    <div class="col-md-3 text-center"><i class="bi bi-shield-check display-4" style="color:var(--primary)"></i><h6 class="mt-2 fw-bold">Secure Booking</h6><small class="text-muted">SSL encrypted</small></div>
    <div class="col-md-3 text-center"><i class="bi bi-headset display-4" style="color:var(--primary)"></i><h6 class="mt-2 fw-bold">24/7 Support</h6><small class="text-muted">Always here to help</small></div>
  </div>
</div>

<script>
function switchLogin(type) {
  const passengerForm = document.getElementById('passengerForm');
  const adminForm = document.getElementById('adminForm');
  const passengerBtn = document.getElementById('passengerBtn');
  const adminBtn = document.getElementById('adminBtn');
  if (type === 'passenger') {
    passengerForm.style.display = 'block';
    adminForm.style.display = 'none';
    passengerBtn.classList.add('active');
    adminBtn.classList.remove('active');
  } else {
    passengerForm.style.display = 'none';
    adminForm.style.display = 'block';
    adminBtn.classList.add('active');
    passengerBtn.classList.remove('active');
  }
}
</script>

<%- include('../partials/footer') %>
