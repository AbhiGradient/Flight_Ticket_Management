<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/passenger-sidebar', { active: 'search' }) %>

<div class="main-content">
  <h3 class="mb-4"><i class="bi bi-credit-card"></i> Secure Payment</h3>
  <div class="row">
    <div class="col-md-7">
      <div class="card">
        <div class="card-header bg-white"><h5 class="mb-0">Choose Payment Method</h5></div>
        <div class="card-body">
          <form action="/booking/payment" method="POST" id="paymentForm">
            <div class="mb-3">
              <div class="form-check mb-2 p-3 border rounded">
                <input class="form-check-input" type="radio" name="payment_method" id="card" value="card" checked onclick="toggleMethod()">
                <label class="form-check-label fw-bold" for="card">
                  <i class="bi bi-credit-card-2-front text-primary"></i> Credit / Debit Card
                </label>
              </div>
              <div class="form-check mb-2 p-3 border rounded">
                <input class="form-check-input" type="radio" name="payment_method" id="upi" value="upi" onclick="toggleMethod()">
                <label class="form-check-label fw-bold" for="upi">
                  <i class="bi bi-phone text-success"></i> UPI
                </label>
              </div>
              <div class="form-check p-3 border rounded">
                <input class="form-check-input" type="radio" name="payment_method" id="netbanking" value="netbanking" onclick="toggleMethod()">
                <label class="form-check-label fw-bold" for="netbanking">
                  <i class="bi bi-bank text-info"></i> Net Banking
                </label>
              </div>
            </div>

            <div id="cardFields">
              <div class="mb-3">
                <label class="form-label">Card Number</label>
                <input type="text" name="card_number" class="form-control" placeholder="1234 5678 9012 3456" maxlength="19">
              </div>
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label">Expiry</label>
                  <input type="text" name="card_expiry" class="form-control" placeholder="MM/YY" maxlength="5">
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label">CVV</label>
                  <input type="password" name="card_cvv" class="form-control" placeholder="***" maxlength="3">
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label">Cardholder Name</label>
                <input type="text" name="card_name" class="form-control" placeholder="Name on card">
              </div>
            </div>

            <div id="upiFields" style="display:none">
              <div class="mb-3">
                <label class="form-label">UPI ID</label>
                <input type="text" name="upi_id" class="form-control" placeholder="yourname@upi">
              </div>
            </div>

            <button type="button" class="btn btn-primary w-100 btn-lg" onclick="processPayment()">
              <i class="bi bi-lock-fill"></i> Pay ₹<%= booking.amount.toLocaleString('en-IN') %>
            </button>
            <p class="text-center text-muted small mt-2 mb-0">
              <i class="bi bi-shield-check"></i> Your transaction is encrypted and secure
            </p>
          </form>
        </div>
      </div>
    </div>

    <div class="col-md-5">
      <div class="card mb-3">
        <div class="card-header bg-white"><h5 class="mb-0"><i class="bi bi-receipt"></i> Price Summary</h5></div>
        <div class="card-body">
          <div class="d-flex justify-content-between mb-2">
            <span>Base Fare</span>
            <strong>₹<%= booking.amount.toLocaleString('en-IN') %></strong>
          </div>
          <div class="d-flex justify-content-between mb-2 text-muted">
            <span>Taxes & Service Fees</span>
            <span>Included</span>
          </div>
          <div class="d-flex justify-content-between mb-2 text-success">
            <span>Discount</span>
            <span>₹0</span>
          </div>
          <hr>
          <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Total Payable</h5>
            <h3 class="text-primary mb-0">₹<%= booking.amount.toLocaleString('en-IN') %></h3>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-body">
          <h6 class="fw-bold mb-3"><i class="bi bi-info-circle"></i> Important Info</h6>
          <small class="text-muted d-block mb-1"><i class="bi bi-check-circle text-success"></i> Free cancellation within 24 hours</small>
          <small class="text-muted d-block mb-1"><i class="bi bi-check-circle text-success"></i> Instant e-ticket delivery</small>
          <small class="text-muted d-block mb-1"><i class="bi bi-check-circle text-success"></i> 100% secure payments</small>
          <small class="text-muted d-block"><i class="bi bi-check-circle text-success"></i> 24/7 customer support</small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- FAKE PAYMENT PROCESSING MODAL -->
<div class="modal fade" id="processingModal" tabindex="-1" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body text-center p-5">
        <div class="spinner-border text-primary mb-3" style="width:3rem;height:3rem"></div>
        <h5>Processing Payment...</h5>
        <p class="text-muted">Please wait while we process your payment</p>
      </div>
    </div>
  </div>
</div>

<!-- SUCCESS MODAL -->
<div class="modal fade" id="successModal" tabindex="-1" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body text-center p-5">
        <div class="mb-3"><i class="bi bi-check-circle-fill" style="font-size:5rem;color:#10b981;animation:pop 0.4s ease"></div>
        <h3 class="text-success mb-2">Payment Successful!</h3>
        <p class="text-muted">Your booking has been confirmed.</p>
        <div class="alert alert-success">
          <strong>Amount Paid: ₹<%= booking.amount.toLocaleString('en-IN') %></strong>
        </div>
        <p class="small text-muted">Redirecting to confirmation page...</p>
      </div>
    </div>
  </div>
</div>

<style>
@keyframes pop { 0% { transform:scale(0); } 80% { transform:scale(1.2); } 100% { transform:scale(1); } }
</style>

<script>
function toggleMethod() {
  const m = document.querySelector('input[name="payment_method"]:checked').value;
  document.getElementById('cardFields').style.display = m === 'card' ? 'block' : 'none';
  document.getElementById('upiFields').style.display = m === 'upi' ? 'block' : 'none';
}

function processPayment() {
  const form = document.getElementById('paymentForm');
  const m = document.querySelector('input[name="payment_method"]:checked').value;

  // Basic validation
  if (m === 'card') {
    const card = form.card_number.value.replace(/\s/g, '');
    if (card.length < 12) { alert('Please enter a valid card number'); return; }
  }

  // Show processing
  const procModal = new bootstrap.Modal(document.getElementById('processingModal'));
  procModal.show();

  // Simulate 2-second payment processing
  setTimeout(() => {
    procModal.hide();
    setTimeout(() => {
      const successModal = new bootstrap.Modal(document.getElementById('successModal'));
      successModal.show();
      // Submit form after showing success
      setTimeout(() => form.submit(), 2000);
    }, 300);
  }, 2000);
}
</script>
<%- include('../partials/footer') %>
