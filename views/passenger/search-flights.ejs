<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/passenger-sidebar', { active: 'search' }) %>

<div class="main-content">
  <h3 class="mb-3">Search Flights</h3>

  <div class="card mb-4">
    <div class="card-body">
      <form action="/passenger/search" method="POST" class="row g-3">
        <div class="col-md-4">
          <label class="form-label small fw-bold"><i class="bi bi-geo-alt"></i> FROM</label>
          <select name="source" class="form-select" required>
            <option value="">Select source</option>
            <% airports.forEach(a => { %>
              <option value="<%= a.id %>" <%= search && search.source==a.id?'selected':'' %>><%= a.city %> (<%= a.code %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label small fw-bold"><i class="bi bi-geo-alt-fill"></i> TO</label>
          <select name="destination" class="form-select" required>
            <option value="">Select destination</option>
            <% airports.forEach(a => { %>
              <option value="<%= a.id %>" <%= search && search.destination==a.id?'selected':'' %>><%= a.city %> (<%= a.code %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label small fw-bold"><i class="bi bi-calendar3"></i> DATE</label>
          <input type="date" name="date" class="form-control" value="<%= search?search.date:'' %>" min="<%= new Date().toISOString().split('T')[0] %>" required>
        </div>
        <div class="col-md-1 d-flex align-items-end">
          <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i></button>
        </div>
      </form>
    </div>
  </div>

  <% if (flights) { %>
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="mb-0"><%= flights.length %> flight(s) found</h5>
      <small class="text-muted"><i class="bi bi-funnel"></i> Sort by: Best</small>
    </div>
    <% if (flights.length === 0) { %>
      <div class="card"><div class="card-body text-center py-5 text-muted">
        <i class="bi bi-airplane display-1"></i><h5 class="mt-3">No flights found</h5>
        <p>Try a different date or route.</p>
      </div></div>
    <% } else { %>
      <% flights.forEach(f => { %>
        <div class="flight-result">
          <div class="row align-items-center">
            <div class="col-md-2">
              <div class="d-flex align-items-center">
                <i class="bi bi-airplane-engines fs-3 me-2" style="color:var(--primary)"></i>
                <div><strong><%= f.airline %></strong><br><small class="text-muted"><%= f.flight_number %></small></div>
              </div>
            </div>
            <div class="col-md-5">
              <div class="d-flex justify-content-between align-items-center">
                <div class="text-center">
                  <div class="flight-time"><%= new Date(f.departure_time).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}) %></div>
                  <div class="flight-city"><%= f.source_code %> · <%= f.source_city %></div>
                </div>
                <div class="text-center flex-grow-1 px-3">
                  <i class="bi bi-arrow-right text-muted"></i>
                  <div class="text-muted small"><%= f.duration %></div>
                  <div class="text-muted" style="border-top:1px dashed #ccc;margin:5px 0"></div>
                </div>
                <div class="text-center">
                  <div class="flight-time"><%= new Date(f.arrival_time).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}) %></div>
                  <div class="flight-city"><%= f.dest_code %> · <%= f.dest_city %></div>
                </div>
              </div>
            </div>
            <div class="col-md-2 text-center">
              <small class="text-muted d-block">From</small>
              <div class="flight-price">₹<%= f.price %></div>
              <small class="text-muted"><%= f.available_seats %> seats</small>
            </div>
            <div class="col-md-3 text-end">
              <a href="/flights/<%= f.id %>" class="btn btn-primary">View Details</a>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  <% } %>
</div>
<%- include('../partials/footer') %>
