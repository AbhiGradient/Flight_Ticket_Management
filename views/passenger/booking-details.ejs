<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/passenger-sidebar', { active: 'bookings' }) %>

<div class="main-content">
  <a href="/passenger/my-bookings" class="text-muted text-decoration-none mb-3 d-inline-block">
    <i class="bi bi-arrow-left"></i> Back
  </a>
  <div class="card">
    <div class="card-header d-flex justify-content-between">
      <h5 class="mb-0">Booking Details</h5>
      <span class="badge bg-light text-dark">PNR: <%= booking.pnr %></span>
    </div>
    <div class="card-body">
      <div class="row mb-4">
        <div class="col-md-6">
          <h6 class="fw-bold">Flight Information</h6>
          <p class="mb-1"><%= booking.airline %> - <strong><%= booking.flight_number %></strong></p>
          <p class="mb-1"><strong>From:</strong> <%= booking.source_city %> (<%= booking.source_code %>)</p>
          <p class="mb-1"><strong>To:</strong> <%= booking.dest_city %> (<%= booking.dest_code %>)</p>
          <p class="mb-1"><strong>Departure:</strong> <%= new Date(booking.departure_time).toLocaleString() %></p>
          <p class="mb-1"><strong>Arrival:</strong> <%= new Date(booking.arrival_time).toLocaleString() %></p>
          <p class="mb-0"><strong>Duration:</strong> <%= booking.duration %></p>
        </div>
        <div class="col-md-6">
          <h6 class="fw-bold">Booking Information</h6>
          <p class="mb-1"><strong>Status:</strong> <span class="badge bg-<%= booking.status==='confirmed'?'success':booking.status==='cancelled'?'danger':'warning' %>"><%= booking.status.toUpperCase() %></span></p>
          <p class="mb-1"><strong>Seat:</strong> <%= booking.seat_number || 'N/A' %></p>
          <p class="mb-1"><strong>Journey Date:</strong> <%= new Date(booking.journey_date).toLocaleDateString() %></p>
          <p class="mb-1"><strong>Booked On:</strong> <%= new Date(booking.booking_date).toLocaleString() %></p>
          <p class="mb-0"><strong>Total Amount:</strong> <span class="text-primary h5">₹<%= booking.total_amount %></span></p>
        </div>
      </div>
      <h6 class="fw-bold">Passenger Information</h6>
      <table class="table table-bordered">
        <thead><tr><th>Name</th><th>Age</th><th>Gender</th><th>Email</th><th>Phone</th></tr></thead>
        <tbody>
          <% passengers.forEach(p => { %><tr><td><%= p.name %></td><td><%= p.age %></td><td><%= p.gender %></td><td><%= p.email %></td><td><%= p.phone %></td></tr><% }) %>
        </tbody>
      </table>
      <div class="text-center">
        <% if (booking.status === 'confirmed') { %><a href="/booking/cancel/<%= booking.id %>" class="btn btn-danger" onclick="return confirm('Cancel?')"><i class="bi bi-x-circle"></i> Cancel Booking</a><% } %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
