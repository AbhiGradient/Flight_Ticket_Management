<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/passenger-sidebar', { active: 'bookings' }) %>

<div class="main-content">
  <h3 class="mb-3">My Bookings</h3>
  <% if (bookings.length === 0) { %>
    <div class="card"><div class="card-body text-center py-5">
      <i class="bi bi-inbox display-1 text-muted"></i>
      <h5 class="mt-3">No bookings yet</h5>
      <a href="/passenger/search" class="btn btn-primary mt-2">Search Flights</a>
    </div></div>
  <% } else { %>
    <div class="card">
      <div class="card-body p-0"><div class="table-responsive"><table class="table">
        <thead><tr><th>PNR</th><th>Flight</th><th>Route</th><th>Journey</th><th>Seat</th><th>Amount</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
          <% bookings.forEach(b => { %>
            <tr>
              <td><strong><%= b.pnr %></strong></td>
              <td><%= b.airline %><br><small class="text-muted"><%= b.flight_number %></small></td>
              <td><%= b.source_city %> → <%= b.dest_city %></td>
              <td><%= new Date(b.journey_date).toLocaleDateString() %></td>
              <td><%= b.seat_number || '-' %></td>
              <td>₹<%= b.total_amount %></td>
              <td><span class="badge bg-<%= b.status==='confirmed'?'success':b.status==='cancelled'?'danger':'warning' %>"><%= b.status.toUpperCase() %></span></td>
              <td>
                <a href="/passenger/booking-details/<%= b.id %>" class="btn btn-sm btn-outline-primary">View</a>
                <% if (b.status === 'confirmed') { %><a href="/booking/cancel/<%= b.id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Cancel this booking?')">Cancel</a><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table></div></div>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
