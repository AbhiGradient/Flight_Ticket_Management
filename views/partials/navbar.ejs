<header class="top-header">
  <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center">
      <button class="menu-toggle" onclick="document.querySelector('.sidebar').classList.toggle('open')">
        <i class="bi bi-list"></i>
      </button>
      <a href="/" class="brand">
        <i class="bi bi-airplane-engines-fill"></i>
        <span>FlightTicket</span>
      </a>
    </div>
    <div class="d-flex align-items-center gap-3">
      <% if (user) { %>
        <span class="d-none d-sm-inline">Hello, <%= user.name %></span>
        <div class="user-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
        <a href="/logout" class="btn btn-sm btn-secondary">
          <i class="bi bi-box-arrow-right"></i> Logout
        </a>
      <% } else { %>
        <a href="/login" class="btn btn-sm btn-secondary">Sign In</a>
      <% } %>
    </div>
  </div>
</header>
